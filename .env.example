# ─────────────────────────────────────────────────────────────
# Recipe Extractor — environment configuration
# Copy this file to `.env` and fill in the values.
# ─────────────────────────────────────────────────────────────

# ---- Anthropic (Claude) ----
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Model used for extraction. Haiku 4.5 is cheap + capable and supports vision.
ANTHROPIC_MODEL=claude-haiku-4-5

# ---- Clerk auth ----
# Dashboard: https://dashboard.clerk.com  → API Keys
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# Your Clerk issuer / Frontend API URL, e.g. https://your-app.clerk.accounts.dev
CLERK_JWT_ISSUER=https://your-app.clerk.accounts.dev

# Publishable key for the React frontend (must start with pk_)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Transcription ----
# faster-whisper model size: tiny | base | small | medium | large-v3
# "small" is a good CPU default. Larger = more accurate but slower.
WHISPER_MODEL=small

# ---- Database ----
POSTGRES_USER=recipes
POSTGRES_PASSWORD=recipes
POSTGRES_DB=recipes
# The backend reads this; leave as-is for Docker Compose.
DATABASE_URL=postgresql+psycopg://recipes:recipes@db:5432/recipes

# ---- Dev toggles ----
# Set to "true" ONLY for local testing without Clerk. All requests then run as a
# single fixed dev user. NEVER enable in production.
# To fully bypass Clerk you must set BOTH of these to true:
#   DISABLE_AUTH=true       -> backend accepts unauthenticated requests
#   VITE_DISABLE_AUTH=true  -> frontend skips Clerk sign-in entirely
DISABLE_AUTH=false
VITE_DISABLE_AUTH=false

# Comma-separated list of origins allowed to call the API (the frontend URL).
CORS_ORIGINS=http://localhost:5173
